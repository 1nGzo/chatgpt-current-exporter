{
  "manifest_version": 3,
  "permissions": ["storage"],
  "name": "Current Conversation Exporter",
  "version": "0.1.0",
  "description": "Capture the current ChatGPT, Gemini or Grok conversation locally and export verified structured data.",
  "action": {
    "default_title": "导出当前会话",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["core/platform.js", "adapters/gemini.js", "fallback-config.js", "injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "core/platform.js",
        "core/normalized.js",
        "adapters/chatgpt.js",
        "adapters/chatgpt-navigator.js",
        "adapters/gemini-isolated.js",
        "converter.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://www.grok.com/*"
      ],
      "js": [
        "converter.js",
        "adapters/grok.js",
        "grok-content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
